namespace foo.bar;

// comments

const NumberOne: i32 = 1;

enum Color: u8 {
    Red, // inline comments
    Green,
    Blue = 5,
}

// enum derives u32 by default
// enum can only derive unsigned integers
enum Numbers {
    Thousand = 1000,
    Million = 1000000,
    Billion = 1000000000,
}

const FavoriteColor: Color = Color.Red;

struct EmptyStruct {}

// struct is a fixed-size type with scalar fields
struct Optional {
    opt: i32?, // optional
}

// component is a variable-size type
component Position {
    x: f32,
    y: f32,
}

struct Velocity {
    x: f32,
    y: f32,
}

message Scalars {
    uint8: u8,
    uint16: u16,
    uint32: u32,
    uint64: u64,
    int8: i8,
    int16: i16,
    int32: i32,
    int64: i64,
    boolean: bool,
    float32: f32,
    float64: f64,

    ts: timestamp, // 64-bit microseconds resolution, UTC
    it: interval, // 64-bit microseconds resolution

    et: entity, // 64-bit local entity (index, generation)
    uet: uentity, // 96-bit universal entity (node ID, shard ID, index, generation)
}

message NonScalars {
    v: vec<i32>,
    s: set<i32>,
    m: map<i32, i32>,

    // complex
    v1: vec<Position>,
    v2: vec<Velocity>,
    v2d: vec<vec<Position>>,
    vs: vec<set<i32>>,
    s1: set<Position>,
    m1: map<u32, Position>,
    m2: map<u8, vec<Position>>,

    str: string,
    b: bytes,
}

// message with a return type
message MyRequest -> MyResponse {
    foo: i32,
}

message MyResponse {
    enum Result {
        Ok,
        Error,
    }

    result: Result,
}
