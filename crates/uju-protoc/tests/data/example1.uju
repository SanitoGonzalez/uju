// The shared test schema, with example2.uju: every declaration kind, type,
// constraint, and layout the compiler handles.
//
// types
// scalars: u8-64, i8-64, f32-64 (f16 TBA), bool, timestamp, duration, entity, uentity, uuid
// variants: string, bytes
// collections: vec<T>, set<T>, map<T>, array<T, N>
// option<T>: collections cannot be optional
// consts: integers, floats, bool, string, duration, and timestamp
// type: a scalar under a name of its own
// union: one of several variants, each with fields, a value, or nothing
// hub: a hub kind, keyed, with a struct's body
// message: between roles, as `(client -> sim)`, `(sim <-> sim)`, or `(client -> hub<Kind>)`
// audience: a keyed set of clients a component can be visible to
// component: an ECS component, with `@replicate`, `@visibility`, and `@halo`
// tag: a component with no value
//
// `uentity` and `uuid` are left out until the Rust backend supports them.

namespace foo.bar

// enum can only derive unsigned integers
enum Color: u8 {
    Red,
    Green,
    Blue = 5,
}

// enum derives u32 by default
enum Numbers {
    Thousand = 1000,
    Million = 1000000,
    Billion = 1000000000,
}

enum Big: u64 {
    Small = 1,
    Huge = 10000000000,
}

// Consts never go on the wire; backends emit them beside the types.
const MaxPlayers: u16 = 64
const MinHeight: i32 = -100
const Gravity: f32 = -9.81
const PvpEnabled: bool = true
const Motd: string = "Welcome!\n\u{1F44B}"
const RespawnDelay: duration = 1500ms
const SeasonStart: timestamp = 2026-11-07T12:00:00Z

// A `type` is laid out as the scalar it names, constraints included.
type PartyId = u64
type Level = u8[max=100]
// Over `bool`, a field of it takes a bitmap bit, as a `bool` does.
type Ready = bool
type Deadline = timestamp

struct EmptyStruct {}

struct Position {
    x: f32,
    y: f32,
}

struct StrangeNumbers {
    // float is finite and non-NaN by default
    a: f32[infinite],
    b: f32[nan],
}

// Fixed-size, with checks: bits, a biased integer, an enum, and a fixed
// string.
struct Tile {
    walkable: bool,
    lit: option<bool>,
    height: i32[min=-100, max=100],
    color: Color,
    tag: string[min_length=2, max_length=2],
    corners: array<u16, 4>,
}

// Variable-size, so collections of it are prefixed.
struct Named {
    id: u32,
    name: string[max_length=8],
}

// Only options: an absent field costs a bit.
struct StatsPatch {
    hp: option<u16>,
    mp: option<u16>,
    alive: option<bool>,
    strength: option<u8>,
}

struct Member {
    id: PartyId,
    level: Level,
    ready: Ready,
}

// A tag, then the variant's data: fields laid out like a struct, a single
// value, or nothing.
union PartyOp {
    Invite { who: PartyId, level: Level, note: option<string[max_length=32]> },
    Kick(PartyId),
    Mute(duration),
    Disband,
}

// A hub kind: objects found by their key, each holding the body as its
// state, laid out as a struct. The key is fixed-size and holds no float.
type GuildId = u64

hub(GuildId) Guild {
    enum Rank {
        Member,
        Officer,
    }

    name: string[max_length=24],
    level: Level,
    ranks: map<PartyId, Rank>,
}

hub(GuildId) GuildBank {
    gold: u64,
}

// A hub kind is not a type: what others see of it is a struct of its own.
struct GuildInfo {
    name: string[max_length=24],
    level: Level,
}

// An audience splits who sees a component by a key, fixed-size and with no
// float, as a hub key.
type FactionId = u32

audience Faction: FactionId
audience Stealth: u8

// A component replaces its whole value on change by default, is seen by
// every client nearby, and reaches neighbor shards.
component Health {
    hp: u32,
    max_hp: u32,
}

// `patch` sends the fields that changed, and `owner` only the controlling
// client sees it.
@replicate(patch)
@visibility(owner)
component Stats {
    strength: u8,
    level: Level,
    title: option<string[max_length=16]>,
    buffs: vec<u16>[max_length=8],
}

// `ops` sends operations of a union, applied by the receiver.
@replicate(ops(PartyOp))
@visibility(Faction)
component Roster {
    members: vec<Member>[max_length=8],
}

// No client sees it, so it reaches neighbor shards only when asked.
@visibility(none)
@halo(true)
component Brain {
    struct Goal {
        target: entity,
        until: timestamp,
    }

    goal: option<Goal>,
}

// A tag has no value: only its addition and removal travel.
tag Dead

@visibility(Stealth)
tag Hidden

@visibility(none)
@halo(false)
tag Thinking

// A message names its endpoints: the roles sending it, an arrow, and the
// roles receiving it. `<->` goes both ways, and `|` lists roles.
message(client <-> entry | edge) Ping {}

message(sim <-> sim) Party {
    leader: PartyId,
    members: vec<PartyId>[max_length=8],
    levels: map<PartyId, Level>,
    roster: vec<Member>,
    history: vec<PartyOp>,
    pending: option<PartyOp>,
}

message(hub<Guild> -> sim) GuildChanged {
    id: GuildId,
    guild: GuildInfo,
}

// A hub kind takes messages from clients and sends to them too.
message(client -> hub<Guild>) GetGuild {}

message(hub<Guild> -> client) GuildState {
    guild: GuildInfo,
}

// `hub<Kind>` names the kind a message goes to. As a sender, bare `hub`
// is any kind, and `hub<A> | hub<B>` only those.
message(client | sim -> hub<GuildBank>) Deposit {
    amount: u64[min=1],
}

message(hub<Guild> | hub<GuildBank> -> client) GuildNotice {
    text: string[max_length=64],
}

message(client -> sim) MyRequest {
    // A const nested in a message, like a nested type.
    const MaxAddresses: u8 = 14

    foo: i32[min=-100, max=100],
    name: string[min_length=2, max_length=12],
    // distinguish collection-wide constraints and element-wide constraints
    addresses: vec<string[max_length=16]>[max_length=14],
}

message(sim -> client) MyResponse {
    enum Result {
        Ok,
        Error,
    }

    result: Result,
}

// Declarations nest more than one level deep.
message(sim | hub -> client) Status {
    struct HTTPDetail {
        enum Kind {
            Client,
            Server,
        }

        code: u16,
        kind: Kind,
        color: Color,
    }

    detail: option<HTTPDetail>,
}

message(client -> sim) Everything {
    a: i8,
    b: i16,
    c: i64[min=0, max=70000],
    d: u64,
    e: u32[min=1000, max=1255],
    f: f64[min=-1.5, max=1.5],
    g: f32[nan, infinite],
    flag: bool,
    who: entity,
    at: timestamp,
    cooldown: duration,
    deadline: Deadline,
    key: bytes[min_length=4, max_length=4],
    big: Big,
    tile: Tile,
    position: Position,
    nothing: EmptyStruct,
    // keywords and generated method names make fine field names
    type: u8[max=9],
    decode: u16,
    maybe_tile: option<Tile>,
    maybe_count: option<u32>,
    maybe_name: option<string[max_length=20]>,
    maybe_at: option<timestamp>,
    blob: bytes,
    raw: vec<u8>,
    waits: vec<duration>,
    flags: vec<bool>[min_length=1, max_length=8],
    points: vec<Position>,
    empties: vec<EmptyStruct>[max_length=9],
    colors: set<Color>,
    names: vec<Named>[max_length=4],
    tags: map<u8, string[max_length=3]>,
    grid: map<u16, Position>,
    matrix: array<array<i8, 2>, 2>,
    bools: array<bool, 3>,
}
