// The shared test schema's second namespace; see example1.uju.

namespace hello
// namespace // empty namespace is legal

use foo.bar

// Types from a `use`d namespace.
message(client -> sim) ExternalTypes {
    color: Color,
    position: foo.bar.Position, // explicit type import
}

message(sim -> client) Spawn {
    entity: entity,
    tile: foo.bar.Tile,
    patch: StatsPatch,
}

// `foo.bar` declares a `MyRequest` too.
message(client -> sim) MyRequest {
    text: string,
}

// A kind from a `use`d namespace.
message(sim -> hub<Guild>) GuildExp {
    amount: u32,
}
